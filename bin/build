#!/bin/bash

# Use flag '-d' to compile with debugging symbols

DEBUG=0

while [ "$1" != "" ]; do
    if [ "$1" == "-d" ]; then
        DEBUG=1
    fi
    shift
done

DIR=$(pwd)
if [[ $DIR != *"/scooble_search/bin"* ]]; then
	echo "Error: You are not in the /scooble_search/bin directory!"
	echo "This bash script is set to use filepaths realative to the bin folder."
	echo "Change your directory with:"
	echo "	  cd [path-to-scooble_search]/scooble_search/bin"
	echo "Then run ./build directly from the bin directory instead."
	exit 1
fi
BUILD_DIR="/tmp/scb_build"
mkdir ${BUILD_DIR}
cd ${BUILD_DIR} || exit

if [ "$DEBUG" -eq 1 ]; then
    cmake -DCMAKE_BUILD_TYPE=Debug "${DIR}/../src" "-DEXECUTABLE_OUTPUT_PATH=${DIR}"
else
    cmake "${DIR}/../src" "-DEXECUTABLE_OUTPUT_PATH=${DIR}"
fi

cmake --build . -- -j "$(nproc)"
rm -rf ${BUILD_DIR}
