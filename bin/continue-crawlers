#!/bin/bash
DIR=$(pwd)
if [[ $DIR != *"/scooble_search/bin"* ]]; then
	echo "Error: You are not in the /scooble_search/bin directory!"
	echo "This bash script is set to use filepaths realative to the bin folder."
	echo "Change your directory with:"
	echo "	  cd [path-to-scooble_search]/scooble_search/bin"
	echo "Then run ./continue-crawlers directly from the bin directory instead."
	exit 1
fi

if [ ! -f $DIR/dummy-indexer ]; then
	echo "Could not find executables needed to run. HINT: Did you forget to run ./build?"
	exit 1
fi

echo " --- Step 1) Setup indexer --- "
# Setup the indexer.
# TODO: Replace the dummy indexer with the real indexer.
./dummy-indexer 2000000 &

echo " --- Step 2) Start filter worker --- "
# Start up the filter worker with thte remote config, bloom file, and worker count.
# TODO: Determine number of machines we are using and ip addresses of them. Also
# update the filter-config.txt file appropriately.
./filter-worker filter-config.txt bloom 0 &

echo " --- Step 3) Start running the crawlers --- "
# Start up all the crawler workers to begin crawling.
# TODO: Determine the number of crawlers we will use and slowly scale up to match.
./crawler-group 50 ../data/english.stemmed.dict &
